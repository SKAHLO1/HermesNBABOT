# ── Standalone mode only (agent.py) ──────────────────────────────────────────
# These vars are ONLY needed when running agent.py directly without Hermes Agent.
# When using Hermes Agent, provider auth is handled via: hermes model (OAuth)
# and secrets are stored in ~/.hermes/.env via: hermes config set KEY value

# Nous Portal API key — get at https://portal.nousresearch.com
# (Hermes Agent uses OAuth instead; this is only for agent.py standalone mode)
NOUS_API_KEY=your_nous_portal_api_key_here
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_MODEL=hermes-4-70b

# ── BallDontLie NBA API ───────────────────────────────────────────────────────
# Free tier: teams, players, games, season averages, standings
# All-Star tier ($9.99/mo): betting odds + player props
# Get your key at https://www.balldontlie.io
#
# For Hermes Agent mode, add via: hermes config set BALLDONTLIE_API_KEY your_key
# For standalone mode, set it here:
BALLDONTLIE_API_KEY=your_balldontlie_api_key_here

# ── Agent tuning (standalone mode only) ───────────────────────────────────────
MAX_TOOL_TURNS=10
